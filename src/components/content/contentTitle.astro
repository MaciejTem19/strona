---
//Tytuł sekcji treści — tekst przez slot, poziom nagłówka z propsa (domyślnie h2).
//
//Przykład użycia:
//
//  ---
//  import ContentTitle from "../content/contentTitle.astro";
//  ---
//  <ContentTitle>Nasza filozofia</ContentTitle>
//  <ContentTitle as="h3">Dla kogo jest kurs</ContentTitle>

export interface Props {
    as?: "h1" | "h2" | "h3" | "h4"
    class?: string
}

const { as: Tag = "h2", class: className = "" } = Astro.props;
---

<Tag class:list={["content-title text-header1", className]}>
    <slot />
</Tag>


<style>
    .content-title {
        margin-top: 2.5rem;
        padding-bottom: 1.5rem;
        text-wrap: balance;
        text-align: center;
        /* Ten sam odcień co tytuł w panelu powitalnym */
        color: var(--color-primary-700);
    }
</style>
