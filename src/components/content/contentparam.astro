---
//Pas z treścią w białej ramce przyklejonej do lewej albo prawej strony (prop direction). Treść przez slot.
//
//Przykład użycia:
//
//  ---
//  import ContentParam from "../content/contentparam.astro";
//  ---
//  <ContentParam direction="left">
//      <ContentTitle>Nasza filozofia</ContentTitle>
//      <ContentText>Uczymy groomingu, ale przede wszystkim uczymy ludzi.</ContentText>
//  </ContentParam>

export interface Props {
    // direction: Direction
    class?: string
}

const {class: className = ""} = Astro.props;
---

<div class:list={["content-param", className]}>
    <div class=`content-param-box`>
        <slot />
    </div>
</div>

<style>
    /* Ramka mniej więcej na środku — direction tylko lekko odsuwa ją w swoją stronę większym paddingiem z drugiej strony */
    .content-param {
        display: flex;
        justify-content: center;
        padding: 2.5rem clamp(1.5rem, 3vw, 4rem);
    }
    .content-param--left {
        padding-right: 8%;
    }
    .content-param--right {
        padding-left: 8%;
    }

    .content-param-box {
        display: flex;
        flex-direction: column;
        gap: 1.1rem;
        /* 70% dostępnego miejsca, bez górnego limitu */
        width: 70%;
        padding: 3rem 3.5rem;
        border-radius: 3.5rem;
        background-color: white;
        /* Uniesienie cieniem zamiast obramowania — mocniejszy, bardziej rozłożony cień dla lepszego efektu „pływającej” ramki */
        box-shadow:
            0 18px 44px -18px color-mix(in oklab, var(--color-dark-950) 42%, transparent),
            0 8px 18px color-mix(in oklab, var(--color-dark-950) 12%, transparent),
            0 0 0 1px color-mix(in oklab, var(--color-dark-950) 6%, transparent);
    }
</style>
