---
import GradientButton from "../../global/gradientButton.astro";

export interface Props {
    text: string
    type?: "primary" | "secondary"
}

const { text, type = "primary" } = Astro.props;

const isSecondary = type === "secondary";

const gradientFrom = isSecondary ? "var(--color-primary-500)" : "var(--color-secondary-400)";
const gradientTo = isSecondary ? "var(--color-primary-700)" : "var(--color-tetriary-500)";
const hoverGradientFrom = isSecondary ? "var(--color-primary-600)" : "var(--color-tetriary-600)";
const hoverGradientTo = isSecondary ? "var(--color-primary-800)" : "var(--color-secondary-600)";
---

<GradientButton
    gradientFrom={gradientFrom}
    gradientTo={gradientTo}
    hoverGradientFrom={hoverGradientFrom}
    hoverGradientTo={hoverGradientTo}
    classses={`free-course-button ${isSecondary ? "free-course-button--secondary" : ""}`}
>
    <span class="free-course-button-label">{text}</span>
</GradientButton>

<style>
    @reference "../../../styles/tailwind.css";

    :global(.free-course-button) {
        /* @apply inline-flex items-center justify-center h-fit px-7 py-3 rounded-[1.5rem] text-lg md:text-xl font-bold text-white whitespace-nowrap overflow-hidden;
                @apply border border-white/30;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1); */
        
        display: inline-flex;
        justify-content: center;
        align-items: center;
        height: fit-content;
        padding: 0.75rem 1.75rem;
        margin-right: 2rem;
        border-radius: 1.5rem;

        color: var(--color-white);
        font-size: var(--text-3xl);
        font-weight: 700;

        /* Tekst w jednej linii, żeby podczas animacji szerokości nie łamał się na dwie */
        white-space: nowrap;
        overflow: hidden;
    }

    /* :global(.free-course-button--secondary) {

    } */

    /* .free-course-button-label {
        @apply inline-flex items-center justify-center text-center text-4xl ;
    } */
</style>
