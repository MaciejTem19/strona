---
export interface Props {
    gradientFrom?: string
    gradientTo?: string
    hoverGradientFrom?: string
    hoverGradientTo?: string
    outLineColor?: string
    hoverOutlineColor?: string
    classses?: string
}

const {gradientFrom, gradientTo, hoverGradientFrom, hoverGradientTo, outLineColor = "transparent", classses} = Astro.props;

const finalClass = `gradient-button ${classses}`

const gradient = `linear-gradient(135deg, ${gradientFrom}, ${gradientTo})`
const hoverGradient = `linear-gradient(135deg, ${hoverGradientFrom}, ${hoverGradientTo})`

---

<button class={finalClass} type="button" style=`background-color: ${gradient};` data-gradient={gradient} data-hover-gradient={hoverGradient}>
    <slot />
</button>


<style define:vars={{ outLineColor }}>
    /* Łapka nad guzikiem — osobna reguła, bo .components-gradient-button nie pasuje do klasy guzika (gradient-button) */
    .gradient-button {
        cursor: pointer;
    }

    .components-gradient-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5em;

        padding: 0.6em 1.4em;
        border: none;
        border-radius: 999px;

        font: inherit;
        font-family: var(--font-button);
        color: inherit;

        box-shadow: 0 1.6px 4.8px rgba(0, 0, 0, 0.15);
        cursor: pointer;
        transition: box-shadow 0.2s ease, transform 0.2s ease;
    }

    .components-gradient-button:hover {
        box-shadow: 0 4.8px 12.8px rgba(0, 0, 0, 0.28);
        outline: 1.6px solid var(--outlineColor);
        outline-offset: 1.6px;
    }

    .components-gradient-button:active {
        transform: translateY(1px);
        box-shadow: 0 6.4px 16px rgba(0, 0, 0, 0.35);
    }

    .components-gradient-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
        box-shadow: none;
        transform: none;
    }

    /* Rozmiary 1–5 — padding jest w em, więc skaluje się razem z font-size */
    .button--1 { font-size: 0.675rem; }
    .button--2 { font-size: 0.787rem; }
    .button--3 { font-size: 0.9rem; }
    .button--4 { font-size: 1.012rem; }
    .button--5 { font-size: 1.125rem; }

</style>

<script>
    import { animate, hover } from "motion";

    document.querySelectorAll<HTMLButtonElement>(".gradient-button").forEach((button) => {
        const { gradient = "", hoverGradient = "" } = button.dataset;

        //Motion nie przelicza var() — bierzemy gradient z policzonego stylu, gdzie kolory są już w rgb i da się je płynnie przejść
        const resolve = (value: string) => {
            button.style.backgroundImage = value;
            return getComputedStyle(button).backgroundImage;
        };
        const hoverValue = resolve(hoverGradient);
        const idleValue = resolve(gradient);

        //Motion rusza od bieżącej wartości elementu i sam zatrzymuje poprzednią animację — przerwany hover startuje od stanu w połowie
        const setGradient = (target: string) => animate(button, { backgroundImage: target }, { duration: 0.2, ease: "easeOut" });

        hover(button, () => {
            setGradient(hoverValue);
            return () => setGradient(idleValue);
        });
    });
</script>