---
import WelcomePanelButtons from "./welcomePanelButtons.tsx";
import WelcomePanelText from "./welcomePanelText.astro";
import GradientButton from "../global/gradientButton.astro";
import { WELCOME_PANEL_CONTENTS } from "./texts";
import WelcomePanelButton from "./welcomePanelButton.astro";
import PawDivider from "../global/pawDevider.astro";
import AdditionalText from "./additionalText.astro";
import PromotionTime from "../promotion/promotionTime.astro";

const [firstContent] = WELCOME_PANEL_CONTENTS;

---


<div id="welcome-panel" class="relative isolate">
    <img class="welcome-background absolute inset-y-0 h-full object-cover pointer-events-none" src={firstContent.imageUrl} alt=""/>
    <div id="content-div" class="relative h-full pr-20 pl-20 pt-8 pb-8">
        <!-- relative — kolumna ma ten sam prostokąt co #content-message, ale nie przycina notki jak jego overflow: hidden.
             my-12 oddaje panelowi tekstu tyle, ile zabrano z paddingu #content-div (5rem → 2rem) — panel zostaje w miejscu, a prawa kolumna z timerem sięga wyżej.
             Bez h-full: komórka grida sama rozciąga kolumnę z uwzględnieniem marginesów, h-full + margines wychodziłoby poza nią -->
        <div class="relative flex flex-col gap-4 my-12 min-h-0">
            <div id="content-message" class="flex-1 min-h-0">
                <!-- Dekoracje w tle panelu — -z-10 w izolowanym #content-message: nad jasnym tłem, ale pod tekstem i guzikami -->
                <span class="content-decoration -z-10 -top-8 right-8 w-52 rotate-12" style={{ "--decoration-src": `url(${import.meta.env.BASE_URL}svgs/tenis_ball.svg)` }}/>
                <span class="content-decoration -z-10 -bottom-8 left-6 w-48" style={{ "--decoration-src": `url(${import.meta.env.BASE_URL}svgs/bone.svg)` }}/>
                <WelcomePanelText title={firstContent.title} content={firstContent.param} id="panel-1"/>
                <!-- to jest by zrobić przerwe -->
                <PawDivider class="welcome-divider mt-auto" color="var(--color-dark-700)" size={32} pawAnimation={false} />
                <div class="w-full justify-center align-middle">
                    <WelcomePanelButtons client:load/>
                </div>
            </div>
            <!-- Środek notki na prawej krawędzi panelu #content-message -->
            <!-- Można dodać ale nie wiem czy będzie pasić -->
            <!-- <div class="absolute right-0 bottom-1/3 translate-x-1/2">
                <AdditionalText text="text text text"/>
            </div> -->
        </div>
        <!-- Kolumna przy prawej krawędzi — justify-between: timer promocji na górze, guzik na dole.
             pb-12 = my-12 panelu tekstu — dół guzika równo z dołem panelu -->
        <div class="flex flex-col h-full w-full justify-between items-end pb-12">
            <!-- Odsunięcie timera od prawej krawędzi panelu -->
            <div class="mr-8">
                <PromotionTime />
            </div>
            <WelcomePanelButton message={firstContent.buttonText} title="wiecej"/>
        </div>
    </div>
</div>


<style>
    #welcome-panel {
        overflow: hidden;
        width: 100%;
        height: 80vh;
        max-height: 30rem 80%;
    }
    #content-div {
        display: grid;
        /* Węższa kolumna panelu tekstu, reszta szerokości dla guzików */
        grid-template-columns: 2fr 3fr;
    }
    #content-message {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 2rem 4rem;
        background-color: color-mix(in oklab, var(--color-light-50) 63%, transparent);
        /* Rozmyte zdjęcie pod półprzezroczystym tłem — efekt matowej szyby, tekst lepiej się odcina */
        backdrop-filter: blur(9.6px);
        -webkit-backdrop-filter: blur(9.6px);
        border-radius: 4rem;

        /* Pod dekoracje: pozycjonowanie, przycięcie do zaokrąglenia i własny kontekst dla -z-10 */
        position: relative;
        overflow: hidden;
        isolation: isolate;
    }
    .content-decoration {
        position: absolute;
        pointer-events: none;
        user-select: none;
        aspect-ratio: 1;

        /* SVG jako maska — czarny kontur z pliku dostaje kolor z tła (dark-700, jak przedziałka) */
        background-color: var(--color-dark-700);
        mask: var(--decoration-src) center / contain no-repeat;
        -webkit-mask: var(--decoration-src) center / contain no-repeat;

        /* Przygaszone, żeby nie walczyły z tekstem */
        opacity: 0.15;
    }
    /* Tło szersze od panelu o 64px z każdej strony — przesuw przy wejściu/wyjściu (BACKGROUND_SHIFT w skrypcie) nie odsłania krawędzi */
    .welcome-background {
        left: -64px;
        width: calc(100% + 128px);
        /* Preflight Tailwinda daje img max-width: 100% — bez tego zdjęcie ucinało się do szerokości panelu i przy left: -64px zostawała przerwa z prawej */
        max-width: none;
    }

</style>


<script>
    import gsap from "gsap";
    import { WELCOME_PANEL_CONTENTS } from "./texts";
    import { PANEL_ENTER_EVENT, PANEL_LEAVE_EVENT, type PanelEventDetail } from "./panelEvents";
    import { enterPawDivider, leavePawDivider } from "../global/pawDividerAnimations";

    const BACKGROUND_FADE_DURATION = 0.8;
    //Przesuw zdjęcia w px — musi być mniejszy niż zapas 64px z .welcome-background
    const BACKGROUND_SHIFT = 32;

    const panel = document.querySelector<HTMLDivElement>("#welcome-panel");

    //Zdjęcia pozostałych scen ściągamy z góry, żeby przy przejściu były już w cache przeglądarki —
    //dopiero po `load`, żeby nie konkurowały o łącze z resztą strony i pierwszym tłem
    function prefetchBackgrounds() {
        WELCOME_PANEL_CONTENTS.slice(1).forEach(({ imageUrl }) => {
            const image = new Image();
            image.decoding = "async";
            image.src = imageUrl;
        });
    }

    if (document.readyState === "complete") prefetchBackgrounds();
    else window.addEventListener("load", prefetchBackgrounds, { once: true });

    //Nowe zdjęcie wchodzi jako kopia nad starym i dopiero po załadowaniu się na nie nakłada —
    //przy jednym <img> podmiana src pokazałaby na chwilę puste tło
    async function setBackgroundImage(url: string) {
        const current = panel?.querySelector<HTMLImageElement>(".welcome-background:last-of-type");
        if (!current || current.src === url) return;

        const next = current.cloneNode() as HTMLImageElement;
        next.src = url;
        gsap.set(next, { autoAlpha: 0, x: -BACKGROUND_SHIFT });
        current.after(next);

        //Bez czekania na dekodowanie zdjęcie wjeżdżałoby kawałkami
        await next.decode().catch(() => {});

        //Stare zdjęcie odjeżdża w prawo pod spodem, nowe wjeżdża z lewej i się na nie nakłada
        gsap.to(current, {
            x: BACKGROUND_SHIFT,
            duration: BACKGROUND_FADE_DURATION,
            ease: "power1.inOut",
            overwrite: "auto",
        });
        gsap.to(next, {
            autoAlpha: 1,
            x: 0,
            duration: BACKGROUND_FADE_DURATION,
            ease: "power1.inOut",
            //Po przejściu zostaje tylko nowe zdjęcie, wszystkie starsze (też z przerwanych przejść) usuwamy
            onComplete: () => {
                panel?.querySelectorAll(".welcome-background").forEach((image) => image !== next && image.remove());
            },
        });
    }

    //Tło zmienia się już na wyjściu panelu, razem z chowaniem tekstu
    document.addEventListener(PANEL_LEAVE_EVENT, (event) => {
        const { index } = (event as CustomEvent<PanelEventDetail>).detail;
        setBackgroundImage(WELCOME_PANEL_CONTENTS[index].imageUrl);
    });

    //Przedziałka chowa się razem z tekstem i rozkłada na nowo, gdy wjeżdża następny panel
    const divider = document.querySelector(".welcome-divider");
    if (divider) {
        document.addEventListener(PANEL_LEAVE_EVENT, () => leavePawDivider(divider));
        document.addEventListener(PANEL_ENTER_EVENT, () => enterPawDivider(divider));
    }
</script>
