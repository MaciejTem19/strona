---
const { heading, titleClass = "text-primary-300" } = Astro.props;
---

<div class="flex flex-col gap-3">
    <h4 class={`m-0 font-header text-[0.95rem] font-semibold uppercase tracking-wider ${titleClass}`}>{heading}</h4>
    <ul class="m-0 p-0 list-none flex flex-col gap-2">
        <slot />
    </ul>
</div>