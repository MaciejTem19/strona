---
import "../styles/tailwind.css";
import ThemePalette from "../components/global/themePalette.astro";
import PaletteExamples from "../components/global/paletteExamples.astro";
import PawDivider from "../components/global/pawDevider.astro";
import ContentTitle from "../components/content/contentTitle.astro";
import ContentText from "../components/content/contentText.astro";
import { ABOUT_SECTIONS, ABOUT_SUPPORT_QUOTE, ABOUT_WELCOME_SUBTITLE, ABOUT_WELCOME_TITLE } from "../components/homepage/texts";
---

<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Test komponentów</title>
	</head>
	<body>
		<h1 class="header-warning font-bold color-red flex w-screen text-3xl">
		    Uwaga: Podstrona została stworzona jedynie do testowania i przedstawiania komponentów znajdujących się na stronie. Ta strona nie zostana dołączona do finalnej wersji projektu.
		</h1>
		<ThemePalette />
		<PaletteExamples />

		<!-- Przedziałka z łapą — guziki odpalają każdą z funkcji animacji -->
		<section class="flex flex-col gap-6 p-10">
			<h2 class="text-header2">PawDivider</h2>
			<PawDivider class="paw-divider-test" />
			<div class="flex gap-3">
				<button type="button" class="paw-test-button" data-paw-action="enter">enterPawDivider</button>
				<button type="button" class="paw-test-button" data-paw-action="leave">leavePawDivider</button>
				<button type="button" class="paw-test-button" data-paw-action="show">showPawDivider</button>
			</div>
		</section>

		<!-- ContentTitle i ContentText — warianty pojedynczo, a niżej cała strona "O nas" złożona z tekstów w texts.ts -->
		<section class="flex flex-col gap-6 p-10">
			<h2 class="text-header2">ContentTitle / ContentText</h2>

			<div class="flex flex-col gap-3">
				<ContentTitle as="h1">{ABOUT_WELCOME_TITLE}</ContentTitle>
				<ContentText size="lg" withPawDivider={true}>{ABOUT_WELCOME_SUBTITLE}</ContentText>
			</div>

			<div class="flex flex-col gap-3">
				<ContentTitle as="h3">Rozmiary ContentText: sm / md / lg</ContentTitle>
				<ContentText size="sm" withPawDivider={true}>{ABOUT_SUPPORT_QUOTE}</ContentText>
				<ContentText withPawDivider={true}>{ABOUT_SUPPORT_QUOTE}</ContentText>
				<ContentText size="lg" withPawDivider={true}>{ABOUT_SUPPORT_QUOTE}</ContentText>
			</div>

			<!-- Sekcje bez tytułu (pierwsza) pokazują same akapity; lista nie ma osobnego komponentu, więc zwykłe ul w kolorze tekstu -->
			{ABOUT_SECTIONS.map((section) => (
				<article class="flex flex-col gap-3">
					{section.title && <ContentTitle>{section.title}</ContentTitle>}
					{section.blocks.map((block) => "paragraph" in block
						? <ContentText withPawDivider={true}>{block.paragraph}</ContentText>
						: <ul class="content-test-list text-content">{block.list.map((item) => <li>{item}</li>)}</ul>
					)}
				</article>
			))}
		</section>
	</body>
</html>
<style>
    .header-warning {
        color: red;
    }
    .paw-test-button {
        padding: 0.4rem 1rem;
        border: 1.5px solid var(--color-dark-800);
        border-radius: 999px;
        font-family: var(--font-mono);
        cursor: pointer;
    }
    .content-test-list {
        list-style: disc;
        padding-left: 1.5rem;
        color: var(--color-dark-800);
    }

</style>


<script>
    import { enterPawDivider, leavePawDivider, showPawDivider } from "../components/global/pawDividerAnimations";

    const PAW_ACTIONS = { enter: enterPawDivider, leave: leavePawDivider, show: showPawDivider };

    const divider = document.querySelector(".paw-divider-test");

    document.querySelectorAll<HTMLButtonElement>("[data-paw-action]").forEach((button) => {
        const action = PAW_ACTIONS[button.dataset.pawAction as keyof typeof PAW_ACTIONS];
        button.addEventListener("click", () => divider && action(divider));
    });
</script>
